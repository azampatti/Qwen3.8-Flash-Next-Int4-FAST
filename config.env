# Paths and the few settings that are not worth putting in front of you.
#
# The knobs you actually tune live in ONE place: the SETTINGS block at the top of serve.sh.
# This file reads them from there, so setup.sh, serve.sh and check.sh always agree.

if [ -z "${MODEL_REPO:-}" ]; then
  SETTINGS_ONLY=1 . "$(dirname "${BASH_SOURCE[0]}")/serve.sh"
fi

# --- rarely changed ----------------------------------------------------------------------------
TABLE_REPO="${TABLE_REPO:-Saren/Qwen3.8-Flash-Next-ple-table-fp8}"   # only used if the model ships without its n-gram table
UPSTREAM_REPO="${UPSTREAM_REPO:-https://github.com/Saren-Arterius/qwen3.8-Flash-DGX-AutoRound.git}"
UPSTREAM_COMMIT="${UPSTREAM_COMMIT:-01c5914f322716b39fd71d5584ed800955582e65}"   # pinned (FULL SHA required); the build this model was validated against
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-qwen38-flash-dgx:upstream}"

# Eugr's b12x stack (https://github.com/eugr/spark-vllm-docker). When that repo is checked out, setup.sh pulls this image
# instead of building ours, and serve.sh launches through Eugr's run-recipe.sh. BACKEND=classic in serve.sh opts out.
# Pinned by digest: Eugr's build of 2026-09-13 (vLLM 0.1.dev20759). His "latest" moves; the 2026-09-21 build is not a
# drop-in for this model yet. Tagged locally as B12X_IMAGE, the name the recipes use.
B12X_IMAGE="${B12X_IMAGE:-vllm-node-b12x}"
B12X_IMAGE_PIN="${B12X_IMAGE_PIN:-eugr/spark-vllm-b12x@sha256:8e7e062186f841453ef0ec6f713043c5b65447decc3835206685128c18e42262}"
B12X_RECIPE="${B12X_RECIPE:-qwen3.8-flash-next-int4-b12x-solo.yaml}"   # what serve.sh runs (single node)
# setup.sh records here which stack it set up (SETUP_BACKEND, SETUP_EUGR_DIR); serve.sh's BACKEND=auto follows it. Not in git.
BACKEND_FILE="$(dirname "${BASH_SOURCE[0]}")/.backend"
SETUP_BACKEND=""; SETUP_EUGR_DIR=""
[ -f "$BACKEND_FILE" ] && . "$BACKEND_FILE"
EUGR_DIR="${EUGR_DIR:-${SETUP_EUGR_DIR:-$HOME/spark-vllm-docker}}"
eugr_present(){ [ -x "$EUGR_DIR/run-recipe.sh" ] && [ -d "$EUGR_DIR/mods" ] && [ -d "$EUGR_DIR/recipes" ]; }

# --- derived paths (you should not need to touch anything below) ---------------------------------
# Resolve a repository to the snapshot folder the Hugging Face cache put it in. Empty if not downloaded yet.
hf_snapshot_dir(){
  local repo="$1" d ref
  d="$HF_HOME/hub/models--${repo//\//--}"
  ref="$(cat "$d/refs/main" 2>/dev/null)" || return 1
  [ -d "$d/snapshots/$ref" ] || return 1
  printf '%s\n' "$d/snapshots/$ref"
}
# The folder holding this repo's blobs AND snapshots; it must be mounted whole, because a snapshot
# is symlinks pointing at ../../blobs/<hash>.
hf_repo_root(){ printf '%s\n' "$HF_HOME/hub/models--${1//\//--}"; }

if [ "$DOWNLOAD_MODE" = cache ]; then
  MODEL_DIR="$(hf_snapshot_dir "$MODEL_REPO" 2>/dev/null || true)"
else
  MODEL_DIR="$MODELS_DIR/$(basename "$MODEL_REPO")"
fi
# The n-gram table ships inside the model. TABLE_REPO is the fallback when it does not.
if [ -n "$MODEL_DIR" ] && [ -d "$MODEL_DIR/ple-table" ]; then
  TABLE_DIR="$MODEL_DIR/ple-table"
elif [ "$DOWNLOAD_MODE" = cache ]; then
  TABLE_DIR="$(hf_snapshot_dir "$TABLE_REPO" 2>/dev/null || true)"
else
  TABLE_DIR="$MODELS_DIR/$(basename "$TABLE_REPO")"
fi
# The draft folder is ours, never inside the cache: small, and the cache must stay exactly as the hub wrote it.
DRAFT_DIR="${DRAFT_DIR:-$MODELS_DIR/$(basename "$MODEL_REPO")-draft-k10}"
