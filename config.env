# Everything you might want to change lives here.

# --- what to serve -----------------------------------------------------------------------------
MODEL_REPO="${MODEL_REPO:-azampatti/Qwen3.8-Flash-Next-125B-A5B-INT4-AutoRound}"   # the model on Hugging Face
TABLE_REPO="${TABLE_REPO:-Saren/Qwen3.8-Flash-Next-ple-table-fp8}"                 # only used if the model ships without its n-gram table

# --- where it lives ----------------------------------------------------------------------------
# cache : the standard Hugging Face cache, shared with every other tool on the machine (default)
# local : a plain folder of real files under MODELS_DIR, if you would rather keep it separate
DOWNLOAD_MODE="${DOWNLOAD_MODE:-cache}"
HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
MODELS_DIR="${MODELS_DIR:-$HOME/models}"     # used by 'local' mode, and always holds the small draft folder

# Resolve a repository to the snapshot folder the Hugging Face cache put it in. Empty if not downloaded yet.
hf_snapshot_dir(){
  local repo="$1" d ref
  d="$HF_HOME/hub/models--${repo//\//--}"
  ref="$(cat "$d/refs/main" 2>/dev/null)" || return 1
  [ -d "$d/snapshots/$ref" ] || return 1
  printf '%s\n' "$d/snapshots/$ref"
}
# The folder holding this repo's blobs AND snapshots; it must be mounted whole, because a snapshot
# is symlinks pointing at ../../blobs/<hash>.
hf_repo_root(){ printf '%s\n' "$HF_HOME/hub/models--${1//\//--}"; }

if [ "$DOWNLOAD_MODE" = cache ]; then
  MODEL_DIR="$(hf_snapshot_dir "$MODEL_REPO" 2>/dev/null || true)"
else
  MODEL_DIR="$MODELS_DIR/$(basename "$MODEL_REPO")"
fi
# The n-gram table ships inside the model. TABLE_REPO is the fallback when it does not.
if [ -n "$MODEL_DIR" ] && [ -d "$MODEL_DIR/ple-table" ]; then
  TABLE_DIR="$MODEL_DIR/ple-table"
elif [ "$DOWNLOAD_MODE" = cache ]; then
  TABLE_DIR="$(hf_snapshot_dir "$TABLE_REPO" 2>/dev/null || true)"
else
  TABLE_DIR="$MODELS_DIR/$(basename "$TABLE_REPO")"
fi
# The draft folder is ours, never inside the cache: small, and the cache must stay exactly as the hub wrote it.
DRAFT_DIR="${DRAFT_DIR:-$MODELS_DIR/$(basename "$MODEL_REPO")-draft-k10}"

# --- images ------------------------------------------------------------------------------------
UPSTREAM_REPO="${UPSTREAM_REPO:-https://github.com/Saren-Arterius/qwen3.8-Flash-DGX-AutoRound.git}"
UPSTREAM_COMMIT="${UPSTREAM_COMMIT:-01c5914}"       # pinned; the build that this model was validated against
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-qwen38-flash-dgx:upstream}"
IMAGE="${IMAGE:-qwen38-flash-dgx:a5b-int4}"

# --- serving -----------------------------------------------------------------------------------
PORT="${PORT:-8000}"
SERVED_NAME="${SERVED_NAME:-qwen3.8-flash-next-a5b}"
CTX="${CTX:-262144}"          # max tokens in one request
SEQS="${SEQS:-8}"             # concurrent requests
KV_BYTES="${KV_BYTES:-20g}"   # KV cache size. 20g = ~645k tokens of cache
MTP="${MTP:-3}"               # speculative decoding depth; 0 disables it
DRAFT_K10="${DRAFT_K10:-1}"   # 1 = draft over 10 experts (faster); 0 = draft like the model
DET_TOPK="${DET_TOPK:-0}"     # 1 = deterministic greedy output (patch 8)
KV_DTYPE="${KV_DTYPE:-auto}"  # fp8_e4m3 = ~1.9x context per GB, slower and slightly worse (patch 7)
TOOL_PARSER="${TOOL_PARSER:-qwen3_coder}"
CHAT_TEMPLATE="${CHAT_TEMPLATE:-}"   # optional path to one of the templates shipped with the model
